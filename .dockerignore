# Keep the backend image lean — only pyproject.toml, uv.lock, README.md,
# src/, db/, and web/squid_arena/ are actually needed to run
# `uvicorn squid_arena.api:app` (see Dockerfile). Everything below is
# excluded from the build context.

.git
.github
.venv
.understand-anything

# Large / irrelevant to the running API
outputs/
archive/
docs/
configs/
scripts/
tests/
notebooks/

# The static frontend is deployed to Pages, not baked into the API image.
# web/squid_arena/ (the backend) must stay in the context -- see Dockerfile.
web/frontend/
web/*.html
web/*.js
web/*.css
web/assets/
web/DEPLOY.md

# Python cruft
__pycache__/
*.py[oc]
*.egg-info
build/
dist/
wheels/

# Local data / secrets
*.db
*.sqlite
*.sqlite3
.env
.env.*

# macOS
.DS_Store
