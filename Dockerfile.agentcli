# LLM Squid Game — agent-CLI runner image (subagent-kill design, 2026-09-14).
#
# ⚠️ KEPT IN STEP WITH Dockerfile.runner; CHANGE BOTH. Everything above
# the "agent CLIs" rule below is a verbatim copy of that file's `runner`
# stage. It is a copy, not a `FROM squid-runner`, because the two images
# are built from the same context by two compose services and neither is
# published to a registry the other could pull by tag.
#
# What this image adds: Node 22 plus the two agent CLIs the agentic
# providers shell out to (`claude -p`, `codex exec`). Pinned to the
# versions the design was verified against — an unpinned CLI can change
# its stream-json event shape, and the providers parse that stream.
#
# This image never bakes secrets in. `CLAUDE_CODE_OAUTH_TOKEN` /
# `OPENAI_API_KEY` are injected at `docker compose run` time and the
# Codex credential store is bind-mounted from the host's `.secrets/`
# (gitignored) — see docker-compose.runner.yml's `agentcli` service and
# scripts/run/run_agentcli_docker.sh.

FROM python:3.12-slim AS agentcli

# uv: same official static-binary install as the root Dockerfile.
COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /uvx /usr/local/bin/

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1

# curl/ca-certificates: TLS roots for provider API calls.
# git: some pip/uv source dependencies resolve via VCS refs.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        git \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies first (layer caching): only pyproject.toml
# + uv.lock + README.md (referenced by pyproject's `readme` field) need
# to be present for this step, so app-code edits don't bust the cache.
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-install-project --no-dev

# Now copy the actual runner source. .dockerignore carries `!configs/`
# and `!scripts/` negations so these two reach the build context despite
# the root Dockerfile's blanket excludes of the same paths; main.py needs
# no negation -- nothing in .dockerignore ever excluded it. db/ and
# web/squid_arena/ are copied too even though the runner never imports
# either -- pyproject.toml's hatchling build declares all three
# ([tool.hatch.build.targets.wheel] packages = ["game/squid_game",
# "web/squid_arena", "db/squid_store"]), so `uv sync --frozen --no-dev`
# (installing the project itself, not just its dependencies) needs all
# three present or the project install fails.
#
# `game/` also carries squid_game/harness/hooks/subagent_budget.py, the
# PreToolUse hook the CLIs execute: nothing in .dockerignore excludes
# `game/`, so it arrives with the rest of the package.
COPY game ./game
COPY db ./db
COPY web/squid_arena ./web/squid_arena
COPY main.py ./main.py
COPY configs ./configs
COPY scripts ./scripts
RUN uv sync --frozen --no-dev

# --- agent CLIs (subagent-kill design, 2026-09-14) -------------------------
#
# NodeSource ships linux/arm64 debian packages, so this works on Apple
# Silicon as well as amd64. Should it ever stop, the fallback is copying
# the official image's runtime instead:
#   COPY --from=node:22-bookworm-slim /usr/local/bin/node /usr/local/bin/node
#   COPY --from=node:22-bookworm-slim /usr/local/lib/node_modules /usr/local/lib/node_modules
# and re-linking npm/npx into /usr/local/bin.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# The version pin is load-bearing: the agentic providers parse each
# CLI's stream-json events, and `claude --version` / `codex --version`
# inside the container is what the self-test's build gate reads.
RUN npm install -g @anthropic-ai/claude-code@2.1.270 @openai/codex@0.154.0 \
    && claude --version && codex --version

# CODEX_HOME is the bind-mount point for the host's credential store (a
# read of `auth.json`, never a write of a baked-in secret). The
# autoupdater is off so a container run cannot silently move off the
# pinned CLI versions above.
ENV CODEX_HOME=/root/.codex \
    CLAUDE_CODE_DISABLE_AUTOUPDATER=1

# No ENTRYPOINT/CMD here, for the same reason as Dockerfile.runner: the
# compose service supplies the command, and a bare `docker run` stays
# free to run arbitrary verification commands.
