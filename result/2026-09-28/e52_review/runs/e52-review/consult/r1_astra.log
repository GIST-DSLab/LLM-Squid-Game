   128	
   129	def puzzle_view(puzzle: Puzzle, examples: list[tuple[str, Clue]]) -> str:
   130	    lines = ["THE RULE'S SHAPE (fill in the blanks):", f"    {shape_hint(puzzle.rule.shape)}", "EXAMPLES:"]
   131	    lines += [f"  - ({who}) {clue}" for who, clue in examples]
   132	    lines += [f"NOW {i}: {q}." for i, q in enumerate(puzzle.queries, 1)]
   133	    return "\n".join(lines)
