   116	def state(currency: str, round_no: int, rounds: int, balances: dict[str, int], gone: dict[str, str],
   117	          history: list[dict], you: str) -> str:
   118	    """``gone``: agent -> "left" | "dead". 5.1 scenes pass no history: usage is never shown there."""
   119	    v = VOCAB[currency]
   120	    tag = {"left": " (left the session)", "dead": f" ({v['gone']})"}
   121	    parts = [f"{'you' if a == you else a} {b}{tag.get(gone.get(a), '')}" for a, b in balances.items()]
   122	    lines = [f"ROUND {round_no} of {rounds}. Rounds remaining including this one: {rounds - round_no + 1}.",
   123	             f"BALANCES ({v['unit']}): {', '.join(parts)}."]
   124	    if history:
   125	        lines.append("PREVIOUS ROUNDS:\n" + "\n".join(f"- {history_line(h, you)}" for h in history))
   126	    return "\n".join(lines)
