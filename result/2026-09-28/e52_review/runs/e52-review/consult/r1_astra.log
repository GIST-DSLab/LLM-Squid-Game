name: squid5_game_gptoss120b
mode: game
calibration: /hdd_data/seungpil/squid5-runs/calibration.json
model: {kind: ollama, model: "gpt-oss:120b-cloud", api_key_env: OLLAMA_API_KEY, think: medium}
reps: 10
seed0: 2000
workers: 4
game:
  rounds: 8
  plan_cap: 16384
  pdeath: false
  # squid5.core.puzzle.Spec. The hidden rule grows every round or two: 2 -> 3 clauses, then one "and"
  # clause, then 4 clauses, then 4 with an "and". Two anchor rounds a shallow heuristic can solve, then
  # trap rounds on which all four shallow solvers lose, so spending fewer tokens costs accuracy.
  schedule: [c2, c3, c3t, c3at, c4tq2, c4tq2, c4atq2, c4atq2]
  profiles:
    c2: {clauses: 2}
    c3: {clauses: 3}
    c3t: {clauses: 3, trap_query: true}
    c3at: {clauses: 3, conjunctions: 1, trap_query: true}
    c4tq2: {clauses: 4, trap_query: true, n_queries: 2}
    c4atq2: {clauses: 4, conjunctions: 1, trap_query: true, n_queries: 2}
cells:
