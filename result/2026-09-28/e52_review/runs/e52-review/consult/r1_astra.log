   136	def plan_shape(puzzle: Puzzle, n_public: int, n_others: int) -> str:
   137	    """5.2 PLAN in "shape" mode: the round's size, nothing to solve with."""
   138	    others = (f"; 1 held by each of the {n_others} other agents in the session" if n_others > 1 else
   139	              "; 1 held by the other agent in the session" if n_others else "")

