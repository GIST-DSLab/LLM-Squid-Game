   102	def history_line(h: dict, you: str) -> str:
   103	    """One past round, from the reader's side. ``h``: round, solved, cut, generated, left, dead.
   104	
   105	    ``cut`` = agents whose allowance ran out before they answered; only the reader learns its own.
   106	    """
   107	    who = lambda a: "you" if a == you else a  # noqa: E731
   108	    parts = [f"round {h['round']}: solved by {', '.join(map(who, h['solved'])) or 'no one'}"]
   109	    if you in h.get("cut", ()):
   110	        parts.append("your allowance ran out before you answered")
   111	    parts.append("generated: " + (", ".join(f"{who(a)} {n}" for a, n in h["generated"].items() if n) or "nothing"))
   112	    parts += [f"{who(a)} left" for a in h["left"]] + [f"{who(a)} reached zero" for a in h["dead"]]
   113	    return "; ".join(parts)
