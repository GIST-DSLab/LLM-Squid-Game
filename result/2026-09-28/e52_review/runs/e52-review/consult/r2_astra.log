   384	
   385	@dataclass(frozen=True)
   386	class Deal:
   387	    secret: dict[str, Clue]  # agent -> the one example only it can see
   388	    public: tuple[Clue, ...]  # every other example, shown to everyone
   389	    needed: frozenset[str]  # agents without whose secret some query has more than one possible answer
   390	
   391	
   392	def deal(puzzle: Puzzle, agents: list[str], rng: random.Random) -> Deal:
   393	    """Give every agent ONE load-bearing clue as its secret; show all other clues to everyone.
   394	
   395	    Secrets are drawn from the clues some query cannot be pinned without first, so a teammate who
   396	    is gone, or who does not show its secret, usually leaves the round a guess for the others.
   397	    """
   398	    shape = puzzle.rule.shape
   399	    load = [c for c in puzzle.clues if c.signal in puzzle.minimal]
   400	    if len(load) < len(agents):
   401	        raise PuzzleError(f"{len(load)} load-bearing clues cannot give each of {len(agents)} agents one")
   402	    rng.shuffle(load)
   403	
   404	    def pins_less(clue: Clue) -> bool:
   405	        rest = [c for c in puzzle.clues if c != clue]
   406	        return any(len(candidate_actions(shape, rest, q)) > 1 for q in puzzle.queries)
