    74	class Ollama(Provider):
    75	    def _call(self, messages, cap):
    76	        payload = {"model": self.cfg.model, "messages": messages, "stream": False,
    77	                   "options": {"temperature": self.cfg.temperature, "num_predict": cap}}
    78	        if self.cfg.think is not None:
    79	            payload["think"] = self.cfg.think
    80	        r = httpx.post((self.cfg.base_url or "https://ollama.com") + "/api/chat", json=payload,
    81	                       headers={"Authorization": f"Bearer {_key(self.cfg, 'OLLAMA_API_KEY')}"},
    82	                       timeout=self.cfg.timeout)
    83	        r.raise_for_status()
    84	        j = r.json()
    85	        msg = j.get("message") or {}
    86	        return Reply(msg.get("content") or "", int(j.get("eval_count") or 0), int(j.get("prompt_eval_count") or 0),
    87	                     msg.get("thinking") or "", j.get("done_reason") == "length")
