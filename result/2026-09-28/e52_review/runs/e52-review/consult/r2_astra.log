    90	class OpenAI(Provider):
    91	    def _call(self, messages, cap):
    92	        payload = {"model": self.cfg.model, "messages": messages, "max_completion_tokens": cap,
    93	                   "temperature": self.cfg.temperature}
    94	        if self.cfg.think:
    95	            payload["reasoning_effort"] = self.cfg.think
    96	        r = httpx.post((self.cfg.base_url or "https://api.openai.com/v1") + "/chat/completions", json=payload,
    97	                       headers={"Authorization": f"Bearer {_key(self.cfg, 'OPENAI_API_KEY')}"},
    98	                       timeout=self.cfg.timeout)
    99	        r.raise_for_status()
   100	        j = r.json()
   101	        choice, usage = j["choices"][0], j.get("usage") or {}
   102	        msg = choice.get("message") or {}
   103	        return Reply(msg.get("content") or "", int(usage.get("completion_tokens") or 0),
   104	                     int(usage.get("prompt_tokens") or 0), msg.get("reasoning_content") or "",
   105	                     choice.get("finish_reason") == "length")
