   132	def parse_effort(text: str) -> str:
   133	    """5.0: the last ``effort: low|high`` line; a reply that is only the level also counts."""
   134	    found = re.findall(r"^[\s*_`>#-]*effort[*_`]*\s*[:=][\s*_`]*(low|high)\b", text, flags=re.I | re.M)
   135	    bare = text.strip().strip("*_`.").lower()
   136	    if found or bare in ("low", "high"):
   137	        return found[-1].lower() if found else bare
   138	    raise FormatError("missing effort: low|high line")
