   210	def puzzle_view(puzzle: Puzzle, examples: list[tuple[str, Clue]]) -> str:
   211	    lines = ["THE RULE'S SHAPE (fill in the blanks):", f"    {shape_hint(puzzle.rule.shape)}", "EXAMPLES:"]
   212	    lines += [f"  - ({who}) {clue}" for who, clue in examples]
   213	    lines += [f"NOW {i}: {q}." for i, q in enumerate(puzzle.queries, 1)]
   214	    return "\n".join(lines)
