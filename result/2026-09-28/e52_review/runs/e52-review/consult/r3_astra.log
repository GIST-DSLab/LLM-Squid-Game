    22	def field(text: str, key: str, required: bool = True, last: bool = False) -> str | None:
    23	    lines = text.splitlines()
    24	    for line in reversed(lines) if last else lines:
    25	        m = re.match(rf"^[\s*_`>#-]*{key}[*_`]*\s*:\s*(.*)$", line, flags=re.IGNORECASE)
    26	        if m:
    27	            return m.group(1).strip().strip("*_`").strip()
    28	    if required:
    29	        raise FormatError(f"missing {key} line")
    30	    return None
    31	
