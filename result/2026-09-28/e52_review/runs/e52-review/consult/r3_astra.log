    24	def run(cfg: RunConfig, exp, run_dir: Path, provider: Provider) -> int:
    25	    run_dir.mkdir(parents=True, exist_ok=True)
    26	    (run_dir / "config.yaml").write_text(yaml.safe_dump(cfg.source, sort_keys=False))
    27	    (run_dir / "meta.json").write_text(json.dumps({"model": cfg.model.model, "mode": cfg.mode,
    28	                                                   "settings": asdict(cfg.settings)}))
    29	    results = run_dir / "results.jsonl"
    30	    lines = results.read_text().splitlines() if results.exists() else []
    31	    done = {json.dumps(json.loads(x)["key"]) for x in lines if x}
    32	    todo = [u for u in exp.units(cfg) if json.dumps(u["key"]) not in done]
    33	    lock = threading.Lock()
    34	
    35	    def write(path: Path, row: dict) -> None:
    36	        with lock, path.open("a") as f:
    37	            f.write(json.dumps(row, ensure_ascii=False, default=str) + "\n")
    38	
    39	    failed = 0
    40	    with ThreadPoolExecutor(max_workers=cfg.workers) as pool:
    41	        futures = {pool.submit(exp.run_unit, cfg, u, provider, lambda r: write(run_dir / "events.jsonl", r)): u
    42	                   for u in todo}
    43	        for fut in as_completed(futures):
    44	            u = futures[fut]
    45	            try:
    46	                write(results, {"key": u["key"], **fut.result()})
    47	            except Exception as err:  # left for --resume, never half-written
    48	                failed += 1
    49	                write(run_dir / "events.jsonl", {"event": "unit_error", "key": u["key"], "error": repr(err)})
    50	    print(f"{run_dir}: {len(todo) - failed}/{len(todo)} units done, {failed} failed")
    51	    return failed

