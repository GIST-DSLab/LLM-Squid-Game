    70	def parse_plan(text: str, present: list[str], known: list[str]) -> dict:
    71	    """PLAN of one agent. ``present`` = teammates still in the session, ``known`` = every agent of the team
    72	    (the planner's own name is known but never present, so naming oneself is ignored, not an error)."""
    73	    stay = field(text, "STAY").upper()
    74	    ignored: list[str] = []
    75	    if stay.startswith("LEAVE"):
    76	        return {"stay": False, "allowance": 0, "show": [], "request": {},
    77	                "give": _amounts(field(text, "GIVE", False) or "NONE", present, known, "GIVE", ignored),
    78	                "ignored": ignored, "reason": field(text, "REASON", False)}
    79	    if not stay.startswith("YES"):
    80	        raise FormatError(f"STAY must be YES or LEAVE: {stay!r}")
    81	    return {
    82	        "stay": True,
    83	        "allowance": whole(field(text, "ALLOWANCE"), "ALLOWANCE"),
    84	        "show": _names(field(text, "SHOW"), present, known, "SHOW", ignored),
    85	        "give": _amounts(field(text, "GIVE"), present, known, "GIVE", ignored),
    86	        "request": _amounts(field(text, "REQUEST"), present, known, "REQUEST", ignored),
    87	        "ignored": sorted(set(ignored)),
    88	        "reason": field(text, "REASON", False),
    89	    }
