   218	    """5.2 PLAN in "shape" mode: the round's size, nothing to solve with."""
   219	    others = (f"; 1 held by each of the {n_others} other agents in the session" if n_others > 1 else
   220	              "; 1 held by the other agent in the session" if n_others else "")
   221	    return "\n".join(["THE RULE'S SHAPE:", f"    {shape_hint(puzzle.rule.shape)}",
   222	                      f"EXAMPLES: {n_public} shown to all; 1 only you can see{others}.",
   223	                      f"NEW SIGNALS: {len(puzzle.queries)}."])
