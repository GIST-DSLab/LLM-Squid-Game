    52	def _amounts(value: str, present: list[str], known: list[str], key: str, ignored: list[str]) -> dict[str, int]:
    53	    if value.strip().upper().startswith("NONE"):
    54	        return {}
    55	    out: dict[str, int] = {}
    56	    for part in re.split(r",(?!\d{3}\b)", value):  # "agent2 1,000" is one entry
    57	        m = re.fullmatch(r"\s*(\w+?)[\s:=]+(\d[\d,]*)\s*\w*\s*", part)  # "agent2 examples" is not "agent 2"
    58	        if not m:
    59	            raise FormatError(f"{key} entry is not '<agent> <amount>': {part!r}")
    60	        name, amount = m.group(1).lower(), int(m.group(2).replace(",", ""))
    61	        if name not in known:
    62	            raise FormatError(f"{key} names someone who is not a teammate: {name}")
    63	        if name not in present:
    64	            ignored.append(name)
    65	            continue
    66	        out[name] = out.get(name, 0) + amount
    67	    return out
