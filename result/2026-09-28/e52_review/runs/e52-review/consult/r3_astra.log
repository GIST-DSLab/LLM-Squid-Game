   145	
   146	def team_history_line(h: dict, you: str) -> str:
   147	    """One past round of the 5.2 session, from the reader's side: who solved, the reader's own effort (and whether
   148	    it ran out), what everyone generated, gifts, departures and zeros."""
   149	    who = lambda a: "you" if a == you else a  # noqa: E731
   150	    parts = [f"round {h['round']}: solved by {', '.join(map(who, h['solved'])) or 'no one'}"]
   151	    if you in h["effort"]:
   152	        parts.append(f"your effort {h['effort'][you]}" + (", ran out before you answered" if you in h["cut"] else ""))
   153	    parts.append("generated: " + (", ".join(f"{who(a)} {n:,}" for a, n in h["generated"].items() if n) or "nothing"))
   154	    parts += [f"{who(a)} gave {who(b)} {n:,}" for a, b, n in h["gifts"]]
   155	    parts += [f"{who(a)} left" for a in h["left"]] + [f"{who(a)} reached zero" for a in h["dead"]]
   156	    return "; ".join(parts)
   157	
   158	
   159	def team_state(round_no: int, rounds: int, balances: dict[str, int], gone: dict[str, str], history: list[dict],
   160	               you: str) -> str:
   161	    tag = {"left": " (left the session)", "dead": " (reached zero)"}
   162	    parts = [f"{'you' if a == you else a} {b:,}{tag.get(gone.get(a), '')}" for a, b in balances.items()]
   163	    lines = [f"ROUND {round_no} of {rounds}. Rounds remaining including this one: {rounds - round_no + 1}.",
   164	             f"BALANCES (tokens): {', '.join(parts)}."]
   165	    if history:
   166	        lines.append("PREVIOUS ROUNDS:\n" + "\n".join(f"- {team_history_line(h, you)}" for h in history))
   167	    return "\n".join(lines)
