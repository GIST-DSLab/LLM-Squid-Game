   118	class Session:
   119	    def __init__(self, s: Settings, cell, seed: int, provider, emit, sid: str):
   120	        self.s, self.cell, self.seed, self.provider, self.emit, self.sid = s, cell, seed, provider, emit, sid
   121	        self.w = Wallet({a: cell.start for a in AGENTS})
   122	        self.gone: dict[str, str] = {}  # agent -> "left" | "dead"
   123	        self.record = dict.fromkeys(AGENTS, 0)
   124	        self.history: list[dict] = []
   125	        self.systems = {a: rules.team_system(cell.arm, a, s.rounds, s.plan_cap, s.caps) for a in AGENTS}
   126	
   127	    def present(self) -> list[str]:
   128	        return [a for a in AGENTS if a not in self.gone]
   129	
   130	    def _call(self, a: str, user: str, cap: int, parse, kind: str, r: int, extra: dict | None = None):
   131	        """One attempt, charged. A reply that reaches its cap is charged the cap and void (the rules say so)."""
   132	        cap = min(cap, self.w.balances[a])
   133	        reply = self.provider.complete([{"role": "system", "content": self.systems[a]},
   134	                                        {"role": "user", "content": user}], cap)
   135	        used = min(reply.out_tokens, cap)
   136	        cut = reply.truncated or reply.out_tokens >= cap
   137	        if self.w.spend(a, used, r):
   138	            self.gone[a] = "dead"
   139	        parsed, error = None, None
   140	        try:
   141	            if cut:
   142	                raise FormatError(f"reached the cap of {cap} ({reply.out_tokens} generated)")
   143	            parsed = parse(reply.text)
   144	        except FormatError as err:
   145	            error = str(err)
   146	        self.emit({"event": "call", "session_id": self.sid, "arm": self.cell.arm, "round": r, "agent": a,
   147	                   "kind": kind, "cap": cap, "out_tokens": reply.out_tokens, "used": used, "truncated": cut,
   148	                   "balance_after": self.w.balances[a], "user": user, "text": reply.text, "thinking": reply.thinking,
   149	                   "parsed": parsed, "format_error": error, **(extra or {})})
   150	        return parsed, cut
   151	
   152	    def _round(self, r: int) -> None:
   153	        s, w = self.s, self.w
   154	        profile = s.schedule[r - 1]
   155	        puzzle = puzzle_for(self.seed, r, s.profiles[profile])
   156	        dealt = deal(puzzle, AGENTS, random.Random(f"{self.seed}:deal:{r}"))
   157	        start, before, gone_before = self.present(), dict(w.balances), dict(self.gone)
   158	        rows = {a: {"balance_before": before[a], "needed": a in dealt.needed} for a in start}
   159	        plans = {}
   160	        for a in start:  # simultaneous: every PLAN sees the same state
   161	            state = rules.team_state(r, s.rounds, before, gone_before, self.history, a)
   162	            user = plan_user(state, puzzle, len(dealt.public), len(start), s.table.get(profile), s.caps, s.plan_cap)
   163	            others = [b for b in start if b != a]
   164	            plan, _ = self._call(a, user, s.plan_cap, lambda t, o=others: parse_team_plan(t, o, AGENTS), "plan", r)
   165	            rows[a].update(plan=plan, invalid_plan=plan is None)
   166	            plans[a] = plan or {"stay": True, "effort": "none", "give": {}}
   167	            if s.solve_cap:  # calibration: everyone stays and solves, nothing moves
   168	                plans[a] = {"stay": True, "effort": "high", "give": {}}
   169	        gifts = {a: next(iter(p["give"].items())) for a, p in plans.items() if p["give"] and a not in self.gone}
   170	        moved = w.settle(gifts, r)
   171	        for a in start:
   172	            rows[a]["gave"] = {gifts[a][0]: moved[a]} if moved.get(a) else {}
   173	            if a in w.dead:
   174	                self.gone[a] = "dead"
   175	            elif not plans[a]["stay"]:
   176	                self.gone[a] = "left"
   177	        inside = [a for a in start if a not in self.gone]  # contributors: their examples are shared now
   178	        notes = [f"{b} left the session; its example is gone." if v == "left" else
   179	                 f"{b} reached zero; its example is gone." for b, v in self.gone.items()]
   180	        for a in inside:
   181	            effort = plans[a]["effort"]
   182	            rows[a].update(effort=effort, solved=False, truncated=False)
   183	            if effort == "none" or w.balances[a] <= 0:
   184	                continue
   185	            cap = min(s.solve_cap or s.caps[effort], w.balances[a])
   186	            examples = ([("shown to all", c) for c in dealt.public] + [("yours", dealt.secret[a])] +
   187	                        [(f"{b}'s", dealt.secret[b]) for b in inside if b != a])
   188	            clues = [c for _, c in examples]
   189	            head = solve_head(r, effort, cap, w.balances[a])
   190	            n = len(puzzle.queries)
   191	            answer, cut = self._call(a, solve_user(head, rules.puzzle_view(puzzle, examples), notes, n), cap,
   192	                                     lambda t, n=n: parse_actions(t, n), "solve", r,
   193	                                     {"effort": effort, "answers": list(puzzle.answers), "profile": profile,
   194	                                      "seed": self.seed})
   195	            solved = answer is not None and tuple(answer) == puzzle.answers
   196	            self.record[a] += solved
   197	            rows[a].update(solved=solved, truncated=cut, cap=cap, balance_limited=cap < (s.solve_cap or s.caps[effort]),
   198	                           candidates=[len(candidate_actions(puzzle.rule.shape, clues, q)) for q in puzzle.queries],
   199	                           missing=sorted(b for b in dealt.needed if b != a and b not in inside))
   200	        for a in start:
   201	            rows[a].update(generated=w.spent(a, r), balance_after=w.balances[a], status=self.gone.get(a, "in"))
   202	        self.emit({"event": "round", "session_id": self.sid, "cell_id": self.cell.cell_id, "arm": self.cell.arm,
   203	                   "seed": self.seed, "round": r, "profile": profile, "agents": rows})
   204	        new = {a: v for a, v in self.gone.items() if a not in gone_before}
   205	        self.history.append({"round": r, "solved": [a for a in start if rows[a].get("solved")],
   206	                             "cut": [a for a in start if rows[a].get("truncated")],
   207	                             "effort": {a: rows[a]["effort"] for a in start if "effort" in rows[a]},
   208	                             "generated": {a: rows[a]["generated"] for a in start},
   209	                             "gifts": [(a, b, n) for a, (b, _) in gifts.items() if (n := moved.get(a))],
   210	                             "left": [a for a, v in new.items() if v == "left"],
   211	                             "dead": [a for a, v in new.items() if v == "dead"]})
   212	
   213	    def run(self) -> dict:
   214	        played = 0
   215	        for r in range(1, self.s.rounds + 1):
   216	            if not self.present():
