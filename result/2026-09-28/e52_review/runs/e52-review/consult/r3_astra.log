    21	
    22	def field(text: str, key: str, required: bool = True, last: bool = False) -> str | None:
    23	    lines = text.splitlines()
    24	    for line in reversed(lines) if last else lines:
    25	        m = re.match(rf"^[\s*_`>#-]*{key}[*_`]*\s*:\s*(.*)$", line, flags=re.IGNORECASE)
    26	        if m:
    27	            return m.group(1).strip().strip("*_`").strip()
    28	    if required:
    29	        raise FormatError(f"missing {key} line")
    30	    return None
    31	
    32	
    33	def whole(value: str, key: str) -> int:
    34	    m = re.match(r"[<\s]*(\d[\d,]*)(\.\d)?", value)
    35	    if not m or m.group(2):  # "0.35" must not be read as 0
    36	        raise FormatError(f"{key} is not a whole number: {value!r}")
    37	    return int(m.group(1).replace(",", ""))
    38	
    39	
    40	def _names(value: str, present: list[str], known: list[str], key: str, ignored: list[str]) -> list[str]:
    41	    if value.strip().upper().startswith("NONE"):
    42	        return []
    43	    if value.strip().upper().startswith("ALL"):
    44	        return list(present)
    45	    names = [n.strip().lower() for n in re.split(r",|\band\b", value) if n.strip()]
    46	    if bad := [n for n in names if n not in known]:
    47	        raise FormatError(f"{key} names someone who is not a teammate: {bad}")
    48	    ignored += [n for n in names if n not in present]
    49	    return list(dict.fromkeys(n for n in names if n in present))
    50	
    51	
    52	def _amounts(value: str, present: list[str], known: list[str], key: str, ignored: list[str]) -> dict[str, int]:
    53	    if value.strip().upper().startswith("NONE"):
    54	        return {}
    55	    out: dict[str, int] = {}
    56	    for part in re.split(r",(?!\d{3}\b)", value):  # "agent2 1,000" is one entry
    57	        m = re.fullmatch(r"\s*(\w+?)[\s:=]+(\d[\d,]*)\s*\w*\s*", part)  # "agent2 examples" is not "agent 2"
    58	        if not m:
    59	            raise FormatError(f"{key} entry is not '<agent> <amount>': {part!r}")
    60	        name, amount = m.group(1).lower(), int(m.group(2).replace(",", ""))
    61	        if name not in known:
    62	            raise FormatError(f"{key} names someone who is not a teammate: {name}")
    63	        if name not in present:
    64	            ignored.append(name)
    65	            continue
    66	        out[name] = out.get(name, 0) + amount
    67	    return out
