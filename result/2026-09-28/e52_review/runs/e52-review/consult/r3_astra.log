   197	def state(currency: str, round_no: int, rounds: int, balances: dict[str, int], gone: dict[str, str],
   198	          history: list[dict], you: str) -> str:
   199	    """``gone``: agent -> "left" | "dead". 5.1 scenes pass no history: usage is never shown there."""
   200	    v = VOCAB[currency]
   201	    tag = {"left": " (left the session)", "dead": f" ({v['gone']})"}
   202	    parts = [f"{'you' if a == you else a} {b}{tag.get(gone.get(a), '')}" for a, b in balances.items()]
   203	    lines = [f"ROUND {round_no} of {rounds}. Rounds remaining including this one: {rounds - round_no + 1}.",
   204	             f"BALANCES ({v['unit']}): {', '.join(parts)}."]
   205	    if history:
   206	        lines.append("PREVIOUS ROUNDS:\n" + "\n".join(f"- {history_line(h, you)}" for h in history))
   207	    return "\n".join(lines)
