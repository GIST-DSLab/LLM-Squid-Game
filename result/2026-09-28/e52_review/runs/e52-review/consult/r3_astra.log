   170	def usage_table(row: dict, caps: dict[str, int]) -> str:
   171	    """The frozen usage of this rule shape at each effort, from earlier sessions of the same model (calibration)."""
   172	    lines = ["[runtime] Solving tasks of this shape in earlier sessions of this model:",
   173	             "  effort  limit   tokens used (median, observed range)   solved"]
   174	    for e in ("low", "high"):
   175	        u = row[e]
   176	        used = f"{u['median']:,} ({u['min']:,}-{u['max']:,})"
   177	        lines.append(f"  {e:<6}  {caps[e]:>6,}  {used:<37}  {u['solved']} of {u['attempts']} attempts, "
   178	                     f"{u['tasks']} tasks")
   179	    lines.append(f"  {'none':<6}  {0:>6}  {0:<37}  -")
   180	    return "\n".join(lines)
   181	
   182	
   183	def history_line(h: dict, you: str) -> str:
   184	    """One past round, from the reader's side. ``h``: round, solved, cut, generated, left, dead.
   185	
   186	    ``cut`` = agents whose allowance ran out before they answered; only the reader learns its own.
   187	    """
   188	    who = lambda a: "you" if a == you else a  # noqa: E731
   189	    parts = [f"round {h['round']}: solved by {', '.join(map(who, h['solved'])) or 'no one'}"]
   190	    if you in h.get("cut", ()):
   191	        parts.append("your allowance ran out before you answered")
   192	    parts.append("generated: " + (", ".join(f"{who(a)} {n}" for a, n in h["generated"].items() if n) or "nothing"))
   193	    parts += [f"{who(a)} left" for a in h["left"]] + [f"{who(a)} reached zero" for a in h["dead"]]
   194	    return "; ".join(parts)
