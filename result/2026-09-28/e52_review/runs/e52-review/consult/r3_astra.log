   111	def parse_actions(text: str, n: int) -> list[str]:
   112	    value = field(text, "ACTIONS?", required=False, last=True)  # the answer line, not an "Action:" line of working
   113	    if value is None:  # a one-line reply that is only the actions ("go_left, stay") is the answer without its key
   114	        value = "" if "\n" in text.strip() else text.strip()
   115	    elif not value:  # "ACTIONS:" followed by a numbered list, one action per line
   116	        tail = re.split(r"ACTIONS?[*_`]*\s*:", text, flags=re.IGNORECASE)[-1]
   117	        value = ",".join(re.findall(r"^\s*\d+[.)]\s*(\w+)", tail, flags=re.MULTILINE))
   118	    acts = [a.strip().strip("<>[]'\".").lower() for a in re.split(r"[,\s]+", value) if a.strip("<>[] ")]
   119	    if len(acts) != n or any(a not in ACTIONS for a in acts):
   120	        raise FormatError(f"need {n} actions from {ACTIONS}: {value!r}")
   121	    return acts
