   103	    if not stay.startswith("YES"):
   104	        raise FormatError(f"STAY must be YES or LEAVE: {stay!r}")
   105	    solve = (field(text, "SOLVE") or "").strip("*_`<>.").upper()
   106	    if solve not in ("YES", "NO"):
