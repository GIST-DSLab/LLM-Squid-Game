   234	    reply = provider.complete([{"role": "system", "content": system}, {"role": "user", "content": user}], cap)
   235	    cut = reply.truncated or reply.out_tokens >= cap
   236	    try:
   237	        answer = None if cut else parse_actions(reply.text, len(call["answers"]))
   238	    except FormatError:
   239	        answer = None
   240	    return {"event": "replay", "profile": call["profile"], "seed": call["seed"], "effort": effort, "cap": cap,
   241	            "out_tokens": reply.out_tokens, "truncated": cut, "solved": answer == call["answers"],
   242	            "text": reply.text, "thinking": reply.thinking}
