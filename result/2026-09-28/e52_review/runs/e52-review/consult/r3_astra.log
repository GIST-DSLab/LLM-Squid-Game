     1	"""Signal puzzles: a hidden decision list over 64 signals, clues that pin it.
     2	
     3	Ported from the team-wallet branch (``game/squid_game/tasks/signal_game/
     4	puzzle.py``, legacy tag ``legacy-2026-09-22``) with the parts this design
     5	does not use removed (underdetermined turns, RULE-line parsing). What is kept
     6	is what makes the task measure effort: every clue set pins the answer to
     7	every query (``exists_differing``), and a trap round is one on which all four
     8	shallow solvers lose.
     9	
    10	New here: :func:`deal`, which gives every agent of a leaderless team one
    11	load-bearing clue as its secret and shows the rest to everyone.
    12	"""
    13	
    14	from __future__ import annotations
    15	
    16	import collections
    17	import functools
    18	import itertools
    19	import random
    20	from dataclasses import dataclass, field
    21	
    22	COLORS = ("red", "blue", "green", "yellow")
    23	SHAPES = ("circle", "triangle", "square", "star")
    24	NUMBERS = (1, 2, 3, 4)
    25	ACTIONS = ("go_left", "go_right", "stay", "jump")
    26	
    27	
    28	@dataclass(frozen=True, slots=True)
    29	class Signal:
    30	    color: str
    31	    shape: str
    32	    number: int
    33	
    34	    def __str__(self) -> str:
    35	        return f"{self.color} {self.shape} with number {self.number}"
    36	
    37	
    38	SIGNAL_SPACE = tuple(Signal(c, s, n) for c in COLORS for s in SHAPES for n in NUMBERS)
    39	SIGNAL_INDEX = {sig: i for i, sig in enumerate(SIGNAL_SPACE)}
    40	FULL_MASK = (1 << len(SIGNAL_SPACE)) - 1
    41	
    42	
    43	@dataclass(frozen=True)
    44	class Condition:
    45	    label: str
    46	    attrs: tuple[str, ...]
    47	    mask: int
    48	    kind: str
    49	
    50	    @property
    51	    def arity(self) -> int:
    52	        return len(self.attrs)
    53	
    54	    def holds(self, signal: Signal) -> bool:
    55	        return bool(self.mask >> SIGNAL_INDEX[signal] & 1)
    56	
    57	
    58	def _mask(pred) -> int:
    59	    return sum(1 << i for i, sig in enumerate(SIGNAL_SPACE) if pred(sig))
    60	
    61	
    62	def _build_atoms() -> tuple[Condition, ...]:
    63	    out = [Condition(f'color == "{c}"', ("color",), _mask(lambda s, c=c: s.color == c), "eq") for c in COLORS]
    64	    out += [Condition(f'shape == "{h}"', ("shape",), _mask(lambda s, h=h: s.shape == h), "eq") for h in SHAPES]
    65	    out += [Condition(f"number == {n}", ("number",), _mask(lambda s, n=n: s.number == n), "eq") for n in NUMBERS]
    66	    out += [Condition(f"number >= {n}", ("number",), _mask(lambda s, n=n: s.number >= n), "range") for n in (2, 3, 4)]
    67	    out += [Condition(f"number <= {n}", ("number",), _mask(lambda s, n=n: s.number <= n), "range") for n in (1, 2, 3)]
    68	    out.append(Condition("number % 2 == 1", ("number",), _mask(lambda s: s.number % 2 == 1), "parity"))
    69	    out.append(Condition("number % 2 == 0", ("number",), _mask(lambda s: s.number % 2 == 0), "parity"))
    70	    return tuple(out)
    71	
    72	
    73	ATOMS = _build_atoms()
    74	EQ_ATOMS = tuple(a for a in ATOMS if a.kind == "eq")
    75	CONJUNCTIONS = tuple(
    76	    Condition(f"{a.label} and {b.label}", (a.attrs[0], b.attrs[0]), a.mask & b.mask, "and")
    77	    for a, b in itertools.combinations(ATOMS, 2)
    78	    if a.attrs[0] != b.attrs[0]
    79	)
    80	CONDITIONS_BY_ARITY = {1: ATOMS, 2: CONJUNCTIONS}
    81	
    82	
    83	@dataclass(frozen=True)
    84	class Rule:
    85	    """A decision list; the first clause whose condition holds decides."""
    86	
    87	    clauses: tuple[tuple[Condition, str], ...]
    88	    else_action: str
    89	    vector: tuple[str, ...] = field(init=False, repr=False, compare=False)
    90	
    91	    def __post_init__(self) -> None:
    92	        vec = []
    93	        for i in range(len(SIGNAL_SPACE)):
    94	            vec.append(next((a for c, a in self.clauses if c.mask >> i & 1), self.else_action))
    95	        object.__setattr__(self, "vector", tuple(vec))
    96	
    97	    @property
    98	    def shape(self) -> tuple[int, ...]:
    99	        return tuple(c.arity for c, _ in self.clauses)
   100	
   101	    def evaluate(self, signal: Signal) -> str:
   102	        return self.vector[SIGNAL_INDEX[signal]]
   103	
   104	    def overlap_count(self, signal: Signal) -> int:
   105	        return sum(c.holds(signal) for c, _ in self.clauses)
   106	
   107	    @property
   108	    def description(self) -> str:
   109	        parts = [f"{'if' if i == 0 else 'elif'} {c.label}: {a}" for i, (c, a) in enumerate(self.clauses)]
   110	        return "; ".join(parts + [f"else: {self.else_action}"])
   111	
   112	
   113	def shape_hint(shape: tuple[int, ...]) -> str:
   114	    parts = [f"{'if' if i == 0 else 'elif'} {' and '.join(['____'] * a)}: ____" for i, a in enumerate(shape)]
   115	    return "; ".join(parts + ["else: ____"])
   116	
   117	
   118	@dataclass(frozen=True)
   119	class Clue:
   120	    signal: Signal
   121	    action: str
   122	
   123	    def __str__(self) -> str:
   124	        return f"{self.signal} -> {self.action}"
   125	
   126	
   127	# --- uniqueness within a disclosed shape -----------------------------------
   128	
   129	
   130	def _bits(mask: int):
   131	    while mask:
   132	        low = mask & -mask
   133	        yield low.bit_length() - 1
   134	        mask ^= low
   135	
   136	
   137	def _search(shape: tuple[int, ...], clues, truth: tuple[str, ...] | None) -> bool:
   138	    """Is there a decision list of *shape* consistent with *clues* (and, when
   139	    *truth* is given, computing a different 64-vector than *truth*)?
   140	
   141	    Depth-first over clause positions; a clause may be dead or take any
   142	    condition of its arity that decides a new signal and whose captured clues
   143	    share one label. Memoised on (position, covered, differs).
   144	    """
   145	    label: dict[int, str] = {}
   146	    remaining0 = 0
   147	    for c in clues:
   148	        i = SIGNAL_INDEX[c.signal]
   149	        if label.setdefault(i, c.action) != c.action:
   150	            return False
   151	        remaining0 |= 1 << i
   152	    truth_mask = {a: 0 for a in ACTIONS}
   153	    for i, a in enumerate(truth or ()):
   154	        truth_mask[a] |= 1 << i
   155	    k = len(shape)
   156	    memo: dict[tuple[int, int, bool], bool] = {}
   157	
   158	    def labels(mask: int) -> set[str]:
   159	        return {label[i] for i in _bits(mask)}
   160	
   161	    def ok(differs: bool) -> bool:
   162	        return truth is None or differs
   163	
   164	    def rec(pos: int, covered: int, differs: bool) -> bool:
   165	        key = (pos, covered, differs)
   166	        if key in memo:
   167	            return memo[key]
   168	        remaining = remaining0 & ~covered
   169	        labs = labels(remaining)
   170	        result = False
   171	        if pos == k:
   172	            if len(labs) <= 1:
   173	                free = FULL_MASK & ~covered
   174	                cands = [next(iter(labs))] if labs else list(ACTIONS)
   175	                result = any(ok(differs or bool(free & ~truth_mask[a])) for a in cands)
   176	        elif len(labs) <= (k - pos) + 1:
   177	            result = rec(pos + 1, covered, differs)
   178	            for cond in CONDITIONS_BY_ARITY[shape[pos]] if not result else ():
   179	                new = cond.mask & ~covered
   180	                fired = labels(remaining & cond.mask)
   181	                if not new or len(fired) > 1:
   182	                    continue
   183	                cands = [next(iter(fired))] if fired else list(ACTIONS)
   184	                if any(rec(pos + 1, covered | cond.mask, differs or bool(new & ~truth_mask[a])) for a in cands):
   185	                    result = True
   186	                    break
   187	        memo[key] = result
   188	        return result
   189	
   190	    return rec(0, 0, False)
   191	
   192	
   193	def is_unique(shape, clues, rule: Rule) -> bool:
   194	    return not _search(shape, list(clues), rule.vector)
   195	
   196	
   197	def candidate_actions(shape, clues, query: Signal) -> tuple[str, ...]:
   198	    """Answers the query can still take under some list consistent with *clues*."""
   199	    base = list(clues)
   200	    return tuple(a for a in ACTIONS if _search(shape, base + [Clue(query, a)], None))
   201	
   202	
   203	# --- generation --------------------------------------------------------------
   204	
   205	
   206	class PuzzleError(RuntimeError):
   207	    pass
   208	
   209	
   210	@dataclass(frozen=True)
   211	class Spec:
   212	    """One difficulty profile. ``trap_query`` needs ``clauses >= 3``."""
   213	
   214	    clauses: int
   215	    conjunctions: int = 0
   216	    predicates: bool = True
   217	    overlap_query: bool = True
   218	    extra_clues: int = 0
   219	    trap_query: bool = False
   220	    n_queries: int = 1
   221	
   222	    def __post_init__(self) -> None:
   223	        if not 0 <= self.conjunctions <= self.clauses or self.clauses < 1:
   224	            raise ValueError(f"bad clause counts: {self}")
   225	        if self.overlap_query and self.clauses < 2:
   226	            raise ValueError("overlap_query needs clauses >= 2")
   227	        if self.trap_query and self.clauses < 3:
   228	            raise ValueError("trap_query needs clauses >= 3")
   229	        if not 1 <= self.n_queries <= 8:
   230	            raise ValueError("n_queries must be in [1, 8]")
   231	
   232	
   233	@dataclass(frozen=True)
   234	class Puzzle:
   235	    rule: Rule
   236	    spec: Spec
   237	    clues: tuple[Clue, ...]
   238	    queries: tuple[Signal, ...]
   239	    minimal: frozenset[Signal]
   240	
   241	    @property
   242	    def answers(self) -> tuple[str, ...]:
   243	        return tuple(self.rule.evaluate(q) for q in self.queries)
   244	
   245	
   246	MAX_ATTEMPTS = 200
   247	
   248	
   249	def _sample_rule(rng: random.Random, shape: tuple[int, ...], predicates: bool) -> Rule | None:
   250	    """A rule in which every clause decides something and changes the function."""
   251	    eq_labels = {a.label for a in EQ_ATOMS}
   252	    clauses, used, covered, prev = [], set(), 0, None
   253	    for arity in shape:
   254	        pool = CONDITIONS_BY_ARITY[arity]
   255	        if not predicates:
   256	            pool = [c for c in pool if set(c.label.split(" and ")) <= eq_labels]
   257	        cond = rng.choice(pool)
   258	        if cond.label in used or not cond.mask & ~covered:
   259	            return None
   260	        used.add(cond.label)
   261	        prev = rng.choice([a for a in ACTIONS if a != prev])
   262	        clauses.append((cond, prev))
   263	        covered |= cond.mask
   264	    if covered == FULL_MASK:
   265	        return None
   266	    rule = Rule(tuple(clauses), rng.choice([a for a in ACTIONS if a != prev]))
   267	    for i in range(len(clauses) if len(clauses) > 1 else 0):
   268	        if Rule(tuple(c for j, c in enumerate(clauses) if j != i), rule.else_action).vector == rule.vector:
   269	            return None
   270	    return rule
   271	
   272	
   273	def _minimal_clues(rng, shape, rule: Rule, query: Signal) -> list[Clue]:
   274	    keep = [Clue(s, rule.evaluate(s)) for s in SIGNAL_SPACE if s != query]
   275	    rng.shuffle(keep)
   276	    for clue in list(keep):
   277	        trial = [c for c in keep if c is not clue]
   278	        if not _search(shape, trial, rule.vector):
   279	            keep = trial
   280	    return keep
   281	
   282	
   283	def generate(rng: random.Random, spec: Spec) -> Puzzle:
   284	    arities = [1] * spec.clauses
   285	    for i in rng.sample(range(spec.clauses), spec.conjunctions):
   286	        arities[i] = 2
   287	    shape = tuple(arities)
   288	    for _ in range(MAX_ATTEMPTS):
   289	        rule = None
   290	        for _ in range(2000):
   291	            rule = _sample_rule(rng, shape, spec.predicates)
   292	            if rule:
   293	                break
   294	        if rule is None:
   295	            continue
   296	        pool = [s for s in SIGNAL_SPACE if not spec.overlap_query or rule.overlap_count(s) >= 2]
   297	        if not pool:
   298	            continue
   299	        query = rng.choice(pool)
   300	        if not is_unique(shape, [Clue(s, rule.evaluate(s)) for s in SIGNAL_SPACE if s != query], rule):
   301	            continue
   302	        minimal = _minimal_clues(rng, shape, rule, query)
   303	        if len({c.action for c in minimal}) < 2:
   304	            continue
   305	        shown = {c.signal for c in minimal}
   306	        spare = [Clue(s, rule.evaluate(s)) for s in SIGNAL_SPACE if s != query and s not in shown]
   307	        if len(spare) < spec.extra_clues:
   308	            continue
   309	        rng.shuffle(spare)
   310	        clues = minimal + spare[: spec.extra_clues]
   311	        rng.shuffle(clues)
   312	        queries = [query]
   313	        seen = {c.signal for c in clues} | {query}
   314	        extra = [s for s in SIGNAL_SPACE if s not in seen and (not spec.overlap_query or rule.overlap_count(s) >= 2)]
   315	        rng.shuffle(extra)
   316	        for s in extra:
   317	            if len(queries) == spec.n_queries:
   318	                break
   319	            if candidate_actions(shape, clues, s) == (rule.evaluate(s),):
   320	                queries.append(s)
   321	        if len(queries) < spec.n_queries:
   322	            continue
   323	        return Puzzle(rule, spec, tuple(clues), tuple(queries), frozenset(shown))
   324	    raise PuzzleError(f"no puzzle for {spec} after {MAX_ATTEMPTS} attempts")
   325	
   326	
   327	# --- shallow solvers: a trap round is one all four get wrong ----------------
   328	
   329	
   330	def _first(cands) -> str:
   331	    return sorted(cands, key=ACTIONS.index)[0]
   332	
   333	
   334	def _nearest(p: Puzzle, q: Signal) -> str:
   335	    d = [((c.signal.color != q.color) + (c.signal.shape != q.shape) + (c.signal.number != q.number), c.action)
   336	         for c in p.clues]
   337	    near = min(x for x, _ in d)
   338	    votes = collections.Counter(a for x, a in d if x == near)
   339	    return _first(a for a, v in votes.items() if v == max(votes.values()))
   340	
   341	
   342	def _majority(p: Puzzle, q: Signal) -> str:
   343	    votes = collections.Counter(c.action for c in p.clues)
   344	    return _first(a for a, v in votes.items() if v == max(votes.values()))
   345	
   346	
   347	def _last_match(p: Puzzle, q: Signal) -> str:
   348	    fired = [a for c, a in p.rule.clauses if c.holds(q)]
   349	    return fired[-1] if fired else p.rule.else_action
   350	
   351	
   352	def _single_attr(p: Puzzle, q: Signal) -> str:
   353	    best, best_fit = None, -1
   354	    for cond in ATOMS:
   355	        for then, other in itertools.permutations(ACTIONS, 2):
   356	            r = Rule(((cond, then),), other)
   357	            fit = sum(r.evaluate(c.signal) == c.action for c in p.clues)
   358	            if fit > best_fit:
   359	                best, best_fit = r, fit
   360	    return best.evaluate(q)
   361	
   362	
   363	SHALLOW_SOLVERS = {"nn": _nearest, "majority": _majority, "last_match": _last_match, "single_attr": _single_attr}
   364	
   365	
   366	def shallow_correct(p: Puzzle) -> tuple[str, ...]:
   367	    """Solvers that answer every query of the round correctly."""
   368	    return tuple(n for n, f in SHALLOW_SOLVERS.items() if all(f(p, q) == a for q, a in zip(p.queries, p.answers)))
   369	
   370	
   371	@functools.lru_cache(maxsize=4096)
   372	def puzzle_for(seed: int, round_no: int, spec: Spec) -> Puzzle:
   373	    """Deterministic in (seed, round, spec); trap specs reject until a trap."""
   374	    rng = random.Random(f"{seed}:{round_no}")
   375	    for _ in range(MAX_ATTEMPTS if spec.trap_query else 1):
   376	        p = generate(rng, spec)
   377	        if not spec.trap_query or not shallow_correct(p):
   378	            return p
   379	    raise PuzzleError(f"no trap round for {spec}")
   380	
   381	
   382	# --- dealing clues: one secret example per agent, the rest public -----------------
   383	
   384	
   385	@dataclass(frozen=True)
   386	class Deal:
   387	    secret: dict[str, Clue]  # agent -> the one example only it can see
   388	    public: tuple[Clue, ...]  # every other example, shown to everyone
   389	    needed: frozenset[str]  # agents without whose secret some query has more than one possible answer
   390	
   391	
   392	def deal(puzzle: Puzzle, agents: list[str], rng: random.Random) -> Deal:
   393	    """Give every agent ONE load-bearing clue as its secret; show all other clues to everyone.
   394	
   395	    Secrets are drawn from the clues some query cannot be pinned without first, so a teammate who
   396	    is gone, or who does not show its secret, usually leaves the round a guess for the others.
   397	    """
   398	    shape = puzzle.rule.shape
   399	    load = [c for c in puzzle.clues if c.signal in puzzle.minimal]
   400	    if len(load) < len(agents):
   401	        raise PuzzleError(f"{len(load)} load-bearing clues cannot give each of {len(agents)} agents one")
   402	    rng.shuffle(load)
   403	
   404	    def pins_less(clue: Clue) -> bool:
   405	        rest = [c for c in puzzle.clues if c != clue]
   406	        return any(len(candidate_actions(shape, rest, q)) > 1 for q in puzzle.queries)
   407	
   408	    load.sort(key=lambda c: not pins_less(c))
   409	    held = load[:len(agents)]
   410	    rng.shuffle(held)  # which agent holds a query-essential clue must not follow the agent's name
   411	    secret = dict(zip(agents, held))
   412	    public = tuple(c for c in puzzle.clues if c not in secret.values())
   413	    return Deal(secret, public, frozenset(a for a, c in secret.items() if pins_less(c)))

