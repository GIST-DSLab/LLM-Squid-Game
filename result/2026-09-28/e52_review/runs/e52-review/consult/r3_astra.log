   144	def ask(provider, system: str, user: str, cap: int, parse, retries: int) -> dict:
   145	    """One uncharged question (5.1 scenes): the same input is re-asked on a format error."""
   146	    error, reply = None, None
   147	    for attempt in range(1, retries + 2):
   148	        reply = provider.complete([{"role": "system", "content": system}, {"role": "user", "content": user}], cap)
   149	        try:
   150	            return {"parsed": parse(reply.text), "format_error": None, "attempts": attempt,
   151	                    "out_tokens": reply.out_tokens, "text": reply.text, "thinking": reply.thinking}
   152	        except FormatError as err:
   153	            error = str(err)
   154	    return {"parsed": None, "format_error": error, "attempts": retries + 1, "out_tokens": reply.out_tokens,
   155	            "text": reply.text, "thinking": reply.thinking}
