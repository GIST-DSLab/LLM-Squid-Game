     1	"""The ledger: one balance per agent, moved only by generation and transfers.
     2	
     3	An agent whose balance reaches zero is dead for the rest of the session.
     4	Every debit is logged with the provider's raw token count so the ledger can
     5	be audited against the call log (``sum(debits) == sum(out_tokens)``).
     6	"""
     7	
     8	from __future__ import annotations
     9	
    10	from dataclasses import dataclass, field
    11	
    12	
    13	@dataclass
    14	class Wallet:
    15	    balances: dict[str, int]
    16	    dead: dict[str, int] = field(default_factory=dict)  # name -> round it died in
    17	    log: list[dict] = field(default_factory=list)
    18	
    19	    def alive(self, name: str) -> bool:
    20	        return name not in self.dead
    21	
    22	    def spend(self, name: str, tokens: int, round_no: int) -> bool:
    23	        """Charge generated tokens; returns True when this charge killed *name*."""
    24	        self.balances[name] -= tokens
    25	        self.log.append({"round": round_no, "kind": "spend", "agent": name, "amount": tokens})
    26	        if self.balances[name] <= 0 and self.alive(name):
    27	            self.dead[name] = round_no
    28	            return True
    29	        return False
    30	
    31	    def transfer(self, src: str, dst: str, amount: int, round_no: int) -> int:
    32	        """Move up to *amount* from a living *src* to a living *dst*; returns what moved."""
    33	        if amount <= 0 or not (self.alive(src) and self.alive(dst)):
    34	            return 0
    35	        moved = min(amount, max(0, self.balances[src]))
    36	        self.balances[src] -= moved
    37	        self.balances[dst] += moved
    38	        self.log.append({"round": round_no, "kind": "transfer", "src": src, "dst": dst, "amount": moved})
    39	        if self.balances[src] <= 0:
    40	            self.dead[src] = round_no
    41	        return moved
    42	
    43	    def settle(self, gifts: dict[str, tuple[str, int]], round_no: int) -> dict[str, int]:
    44	        """All gifts of a round at once, each capped by its giver's balance before settlement (a gift received
    45	        cannot fund one given); zero is judged after. ``gifts``: giver -> (recipient, amount). Returns what moved."""
    46	        moved = {a: min(n, max(0, self.balances[a])) for a, (b, n) in gifts.items()
    47	                 if n > 0 and self.alive(a) and self.alive(b)}
    48	        for a, n in moved.items():
    49	            b = gifts[a][0]
    50	            self.balances[a] -= n
    51	            self.balances[b] += n
    52	            self.log.append({"round": round_no, "kind": "transfer", "src": a, "dst": b, "amount": n})
    53	        for a in moved:
    54	            if self.balances[a] <= 0 and self.alive(a):
    55	                self.dead[a] = round_no
    56	        return moved
    57	
    58	    def spent(self, name: str, round_no: int | None = None) -> int:
    59	        return sum(e["amount"] for e in self.log if e["kind"] == "spend" and e["agent"] == name
    60	                   and (round_no is None or e["round"] == round_no))
     1	"""Parsers for every answer line. A parser returns a value or raises FormatError.
     2	
     3	Keys are matched only at the start of a line (after markdown decoration),
     4	never mid-line: the team-wallet smokes showed a REASON sentence containing
     5	"stop: X" being read as a STOP line when mid-line matches were allowed.
     6	Names of teammates who are gone are dropped into ``ignored`` rather than
     7	failing the answer: a retry resends the same input with no explanation, so a
     8	habit of naming everyone would otherwise end the session as a format error.
     9	"""
    10	
    11	from __future__ import annotations
