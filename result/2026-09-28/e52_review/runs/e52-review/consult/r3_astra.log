   221	                "seed": self.seed, "start": self.cell.start, "rounds_played": played,
   222	                "agents": {a: {"record": self.record[a], "status": self.gone.get(a, "in"), "out_round": next(
   223	                    (h["round"] for h in self.history if a in h["left"] + h["dead"]), None),
   224	                    "final": self.w.balances[a], "spent": self.w.spent(a)} for a in AGENTS},
   225	                "transfers": [e for e in self.w.log if e["kind"] == "transfer"]}
