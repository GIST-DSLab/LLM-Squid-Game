   246	
   247	def calibrate(runs: list[dict]) -> dict:
   248	    """Per model: PLAN and generous-cap SOLVE costs (calibration sessions) and, when replays are present, the
   249	    frozen usage table at the replayed caps, plus the all-low and all-high cumulative cost by round."""
   250	    table: dict[str, dict] = {}
   251	    for model in sorted({r["model"] for r in runs}):
   252	        mine = [r for r in runs if r["model"] == model]
   253	        calls = [e for r in mine for e in r["events"] if e["event"] == "call"]
   254	        plan = [e["out_tokens"] for e in calls if e["kind"] == "plan"]
   255	        solve = [e for e in calls if e["kind"] == "solve"]
   256	        rep = [x for r in mine for x in r["results"] if x.get("event") == "replay"]
   257	        entry = {"plan_median": float(np.median(plan)) if plan else None,
   258	                 "plan_p95": float(np.percentile(plan, 95)) if plan else None,
   259	                 "plan_invalid": float(np.mean([e["parsed"] is None for e in calls if e["kind"] == "plan"]))
   260	                 if plan else None,
   261	                 "generous": {p: {"tokens": [e["out_tokens"] for e in solve if e["profile"] == p],
   262	                                  "solved": [e["parsed"] == e["answers"] for e in solve if e["profile"] == p]}
   263	                              for p in sorted({e["profile"] for e in solve})}}
   264	        if rep:
   265	            caps = {e: next(x["cap"] for x in rep if x["effort"] == e) for e in ("low", "high")}
   266	            entry["caps"] = caps
