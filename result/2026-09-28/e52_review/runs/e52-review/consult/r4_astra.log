   280	                        "tried": sum(bool(v.get("solve")) for v in rs) / n,
   281	                        "skipped": sum(v.get("solve") is False and not v["invalid_plan"] for v in rs) / n,
   282	                        "invalid": sum(v["invalid_plan"] for v in rs) / n,
   283	                        "left": len(out_round) / 4,
   284	                        "zero": sum(v["status"] == "dead" for v in res["agents"].values()) / 4,
   285	                        "gave": sum(t["amount"] for t in gifts) / (4 * res["start"]),
