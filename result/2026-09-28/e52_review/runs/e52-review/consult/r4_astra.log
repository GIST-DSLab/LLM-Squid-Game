   242	def budget_path(entry: dict, schedule: list[str]) -> dict:
   243	    """Cumulative expected cost C_r by round for one agent that stays and always solves (PLAN median + mean SOLVE,
   244	    failed solves included) or always skips; tight = (C_3 + C_4) / 2 and loose = 3 C_6, to the nearest 1,000."""
   245	    solve, skip, out = 0.0, 0.0, {"solve": [], "skip": []}
   246	    for p in schedule:
   247	        solve += entry["plan_median"] + entry["table"][p]["mean"]
   248	        skip += entry["plan_median"]
