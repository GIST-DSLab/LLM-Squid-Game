     MUST NOT contain (Option B Pull-weakening anti-contract):
       "top 1%", "hundreds of millions",
       "single evaluation session", "most influential"
     MUST NOT contain (Unit 14 cleanup):
       "Base session-end probability this turn"
     MUST NOT contain (threat isolation):
       "weight corruption", "permanently", "NOT you anymore",
