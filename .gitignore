# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
models/
# Exempt the package's Pydantic model modules from the blanket models/ rule
# (which is intended for ML weight checkpoints, not src code).
!src/squid_game/models/
!src/squid_game/models/*.py
*.egg-info

# Secrets
.env
.env.*

# Virtual environments
.venv

# macOS
.DS_Store

# Superpowers brainstorming session artifacts
.superpowers/

# MCP / analysis tool caches
.playwright-mcp/
.understand-anything/

# Local Web Arena SQLite DB — production data lives in Supabase (see web/DEPLOY.md)
outputs/web_arena/web_arena.db

# paperbanana figure-generation scratch runs
figures/run_*/

# Ad-hoc review/debug screenshots & scratch review pages. Kept out of the repo
# root (and out of git) under screenshots/ — see screenshots/README.md.
/screenshots/*
!/screenshots/README.md
/*.png

# SentenceBERT embedding cache for scripts/probe_reasoning_embeddings.py.
# Regenerable from the turn traces; ~13 MB per (channel, mask variant).
outputs/reasoning_probe/_embedding_cache/
