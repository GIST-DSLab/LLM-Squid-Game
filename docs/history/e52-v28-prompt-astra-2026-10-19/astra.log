def test_v22_a_refused_give_is_told_to_the_giver_alone():  # 10-17: its chat would show the receiver a bound on the giver's tokens
    res, ev, _ = play({(A6, 1, "prep", 1): f"GIVE {A11} 99999: all of it\nDONE"}, name=V22)
