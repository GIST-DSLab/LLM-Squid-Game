           ("Action: go_left\nFurther reasoning\nstay", ["stay"]), ("Action: go_nowhere\nso\njump", ["jump"]),
           ("thinking\nACTIONS: go_left, stay", ["go_left", "stay"]), ("work\n\nANSWER: jump", ["jump"]),
