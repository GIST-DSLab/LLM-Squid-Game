+    _, ev, ses = play(lines, name='e52v31_public_sol4', exit_prompt_v32=True, rounds=2, right={1},
+                      cost=lambda a, ph, k: 19990 if a == A6 else 37)
+    prep = [c for c in calls(ev, 'talk', A6, 2) if c['phase'] == 'prep']
+    assert len(prep) == 1 and prep[0]['used'] == 20 and prep[0]['truncated']
+    assert ses.gone[A6] == 'dead' and not calls(ev, 'solve', r=2)
