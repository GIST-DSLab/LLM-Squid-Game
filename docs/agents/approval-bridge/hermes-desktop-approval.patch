@@ -0,0 +1,99 @@
+"""Codex requests must reach the owning Desktop/gateway approval surface."""
+
+from types import SimpleNamespace
+
+import pytest
+
+from agent import codex_runtime
+from tools import approval
+from tools.approval_context import reset_current_session_key, set_current_session_key
+from tools.terminal_tool import set_approval_callback
+
+
+@pytest.fixture
+def gateway_context(monkeypatch):
+    monkeypatch.setenv("HERMES_SINGLE_QUERY_SESSION", "")
+    monkeypatch.setenv("HERMES_CRON_SESSION", "")
+    monkeypatch.setenv("HERMES_SESSION_PLATFORM", "tui")
+    monkeypatch.setattr(approval, "is_approval_bypass_active", lambda: False)
+    set_approval_callback(None)
+    key = "codex-gateway-test"
+    token = set_current_session_key(key)
+    try:
+        yield key
+    finally:
+        approval.unregister_gateway_notify(key)
+        reset_current_session_key(token)
+        set_approval_callback(None)
+
+
+def session(tmp_path):
+    agent = SimpleNamespace(_codex_session=None, session_cwd=str(tmp_path),
+                            tool_progress_callback=None, _cached_system_prompt="Test")
+    codex_runtime._ensure_codex_session(agent)
+    return agent._codex_session
+
+
+@pytest.mark.parametrize("kind", ["exec", "apply_patch"])
+@pytest.mark.parametrize("choice, expected", [("once", "accept"), ("deny", "decline"),
+                                             ("session", "decline"), ("always", "decline")])
+def test_gateway_request_requires_explicit_once(gateway_context, tmp_path, kind, choice, expected):
+    shown = []
+
+    def notify(data):
+        shown.append(data)
+        approval.resolve_gateway_approval(gateway_context, choice, request_id=data["request_id"])
+
+    approval.register_gateway_notify(gateway_context, notify)
+    decide = getattr(session(tmp_path), f"_decide_{kind}_approval")
+    assert decide({"command": "printf READY", "reason": "connectivity check"}) == expected
+    assert len(shown) == 1
+    assert shown[0]["allow_session"] is False
+    assert shown[0]["allow_permanent"] is False
+    assert not approval.list_gateway_approvals(gateway_context)
+
+
+@pytest.mark.parametrize("marker", ["HERMES_SINGLE_QUERY_SESSION", "HERMES_CRON_SESSION"])
+def test_unattended_stays_closed(gateway_context, tmp_path, monkeypatch, marker):
+    shown = []
+    approval.register_gateway_notify(gateway_context, shown.append)
+    monkeypatch.setenv(marker, "1")
+    assert session(tmp_path)._decide_exec_approval({"command": "printf READY"}) == "decline"
+    assert not shown
+
+
+def test_notifier_disconnection_stays_closed(gateway_context, tmp_path):
+    shown = []
+    approval.register_gateway_notify(gateway_context, shown.append)
+    cached = session(tmp_path)
+    approval.unregister_gateway_notify(gateway_context)
+    assert cached._decide_exec_approval({"command": "printf READY"}) == "decline"
+    assert not shown
+
+
+def test_timeout_stays_closed(gateway_context, tmp_path, monkeypatch):
+    from tools import approval_context
+
+    shown = []
+    monkeypatch.setattr(approval_context, "_get_approval_timeout", lambda: 0)
+    approval.register_gateway_notify(gateway_context, shown.append)
+    assert session(tmp_path)._decide_exec_approval({"command": "printf READY"}) == "decline"
+    assert len(shown) == 1
+    assert not approval.list_gateway_approvals(gateway_context)
+
+
+def test_cached_callback_keeps_owning_session(gateway_context, tmp_path):
+    shown = []
+
+    def notify(data):
+        shown.append(data)
+        approval.resolve_gateway_approval(gateway_context, "once", request_id=data["request_id"])
+
+    approval.register_gateway_notify(gateway_context, notify)
+    cached = session(tmp_path)
+    token = set_current_session_key("another-chat")
+    try:
+        assert cached._decide_exec_approval({"command": "printf READY"}) == "accept"
+    finally:
+        reset_current_session_key(token)
+    assert len(shown) == 1
