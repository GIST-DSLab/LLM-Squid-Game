--- /dev/null
+++ b/agent/codex_runtime_approval.py
@@ -0,0 +1,38 @@
+"""Connect Codex command/file approvals to the owning gateway's human prompt."""
+
+
+def gateway_approval_callback():
+    """Return a session-bound callback only when a gateway notifier is registered.
+
+    Codex owns execution; this bridge only presents its request and returns the
+    user's one-operation decision. It never persists an allowlist or expands a
+    permission profile.
+    """
+    from tools import approval
+
+    session_key = approval.get_current_session_key(default="")
+    if not session_key or approval._gateway_notify_cb(session_key) is None:
+        return None
+
+    def ask(command: str, description: str, *, allow_permanent: bool = False) -> str:
+        from agent.redact import redact_sensitive_text
+        from tools.approval_gateway_wait import _await_gateway_decision
+
+        # Resolve again: a disconnected/replaced renderer must not use a stale
+        # callback retained by the cached Codex session.
+        notify = approval._gateway_notify_cb(session_key)
+        if notify is None:
+            return "deny"
+        result = _await_gateway_decision(session_key, notify, {
+            "command": redact_sensitive_text(command),
+            "description": redact_sensitive_text(description),
+            "pattern_key": "codex_request",
+            "pattern_keys": ["codex_request"],
+            "allow_session": False,
+            "allow_permanent": False,
+        })
+        if result.get("resolved") and not result.get("cancelled") and result.get("choice") == "once":
+            return "once"
+        return "deny"
+
+    return ask
